# Copy to .env and fill in. .env is gitignored and read by `metacode run`.
# Real environment variables override anything set here.

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-...
# METACODE_LLM_MODEL=claude-opus-5

# OpenAI-compatible provider instead
# METACODE_LLM_PROVIDER=openai
# METACODE_LLM_BASE_URL=https://your-endpoint/v1
# METACODE_LLM_API_KEY=...
# METACODE_LLM_MODEL=...
