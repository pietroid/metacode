{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "metacode: generate",
      "type": "shell",
      "command": "dart run tool/metacode.dart",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "revealProblems": "onProblem" }
    },
    {
      "label": "metacode: watch",
      "detail": "Regenerates .generated/ on every save, for the IDE and tests (the running app recompiles by itself).",
      "type": "shell",
      "command": "dart run tool/metacode.dart watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "metacode",
        "pattern": { "regexp": "^error: (.*)$", "message": 1 },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^metacode: .* changed$",
          "endsPattern": "^metacode: watching"
        }
      },
      "presentation": { "reveal": "silent", "revealProblems": "onProblem" }
    },
    {
      "label": "metacode: check",
      "type": "shell",
      "command": "dart run tool/metacode.dart check",
      "problemMatcher": []
    },
    {
      "label": "metacode: backend",
      "detail": "Starts the Dart Frog backend (server/) on http://localhost:8080 in the background, for examples/my_own_app (data in server/.backend/), and returns once it answers. Keeps running; stop it with the task \"metacode: backend stop\", logs with \"metacode: backend logs\".",
      "type": "shell",
      "command": "tool/backend.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "revealProblems": "onProblem" }
    },
    {
      "label": "metacode: backend stop",
      "type": "shell",
      "command": "tool/backend.sh stop",
      "problemMatcher": []
    },
    {
      "label": "metacode: backend logs",
      "type": "shell",
      "command": "tool/backend.sh logs",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "metacode: generate + backend",
      "dependsOn": ["metacode: generate", "metacode: backend"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "metacode: claude bridge",
      "detail": "Starts the Claude bridge (tool/claude_server.dart) on http://localhost:8787 in the background: the editor's askClaude runs `claude -p` with the metacode MCP through it. Keeps running; stop it with \"metacode: claude bridge stop\", logs with \"metacode: claude bridge logs\".",
      "type": "shell",
      "command": "tool/claude_bridge.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "revealProblems": "onProblem" }
    },
    {
      "label": "metacode: claude bridge stop",
      "type": "shell",
      "command": "tool/claude_bridge.sh stop",
      "problemMatcher": []
    },
    {
      "label": "metacode: claude bridge logs",
      "type": "shell",
      "command": "tool/claude_bridge.sh logs",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "metacode: everything",
      "detail": "Generates, then starts the backend and the Claude bridge.",
      "dependsOn": ["metacode: generate", "metacode: backend", "metacode: claude bridge"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
