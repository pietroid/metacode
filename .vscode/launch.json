{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "metacode (macOS)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "macos",
      "args": [
        "--dart-define=METACODE_STATE_PATH=${workspaceFolder}/examples/my_own_app/.state/state.yaml"
      ],
      "preLaunchTask": "metacode: generate"
    },
    {
      "name": "metacode (pick device)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=METACODE_STATE_PATH=${workspaceFolder}/examples/my_own_app/.state/state.yaml"
      ],
      "preLaunchTask": "metacode: generate"
    }
  ]
}
